{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "MMDC v3 development AWS resources. Neon projects, branches, roles, restore windows, and credentials remain external to CloudFormation.",
  "Metadata": {
    "MMDC": {
      "Environment": "development",
      "Region": "ap-southeast-1",
      "OwnershipBoundary": "AWS resources only; Neon is not modeled or owned by this stack.",
      "RetentionSource": "docs/registers/cost-retention-register.md",
      "ApprovalBoundary": "No account, hostname, credential, or change-set approval is asserted by this template."
    }
  },
  "Parameters": {
    "ProjectName": {
      "Type": "String",
      "Default": "mmdc-v3",
      "AllowedValues": ["mmdc-v3"],
      "Description": "Fixed project tag and resource prefix."
    },
    "EnvironmentName": {
      "Type": "String",
      "Default": "development",
      "AllowedValues": ["development"],
      "Description": "This stack is development-only."
    },
    "OwnerTag": {
      "Type": "String",
      "Default": "Engineering",
      "AllowedValues": ["Engineering"],
      "Description": "Approved accountable owner role for managed AWS resources."
    },
    "GitHubRepository": {
      "Type": "String",
      "Default": "mmdcjpaul/mmdc-core",
      "AllowedPattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$",
      "Description": "Exact GitHub owner/repository allowed to publish development releases."
    },
    "GitHubWorkflowRef": {
      "Type": "String",
      "Default": "mmdcjpaul/mmdc-core/.github/workflows/release.yml@refs/tags/v*.*.*-dev.*",
      "AllowedPattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+/\\.github/workflows/[A-Za-z0-9_.-]+\\.yml@refs/tags/v\\*\\.\\*\\.\\*-dev\\.\\*$",
      "Description": "Exact release workflow file plus the development-tag ref pattern allowed to assume the publisher role. A tag-triggered run emits job_workflow_ref pinned to refs/tags/<tag>, never to a branch, so this value must end with the development-tag glob."
    },
    "GitHubImmutableSubjectPrefix": {
      "Type": "String",
      "Default": "repo:mmdcjpaul@131217386/mmdc-core@1336726789",
      "AllowedPattern": "^repo:[A-Za-z0-9_.-]+@[0-9]+/[A-Za-z0-9_.-]+@[0-9]+$",
      "Description": "Immutable GitHub OIDC subject prefix (owner@owner_id/repo@repo_id) as reported by the repository sub-claim customization endpoint. GitHub issues immutable subjects for this repository, so the plain owner/repo prefix alone never matches."
    },
    "GitHubOidcProviderArn": {
      "Type": "String",
      "Default": "arn:aws:iam::349762920349:oidc-provider/token.actions.githubusercontent.com",
      "AllowedPattern": "^arn:aws:iam::349762920349:oidc-provider/token\\.actions\\.githubusercontent\\.com$",
      "Description": "Existing account-level GitHub Actions OIDC provider; this stack references rather than recreates it."
    },
    "DevelopmentOriginHostname": {
      "Type": "String",
      "Default": "origin.invalid",
      "AllowedPattern": "^[A-Za-z0-9][A-Za-z0-9.-]+$",
      "Description": "Approved Lightsail origin hostname. Edge resources stay disabled until the DNS decision is supplied."
    },
    "DevelopmentHostname": {
      "Type": "String",
      "Default": "dev.invalid",
      "AllowedPattern": "^[A-Za-z0-9][A-Za-z0-9.-]+$",
      "Description": "Approved development hostname used only when edge resources are explicitly enabled."
    },
    "HostedZoneId": {
      "Type": "String",
      "Default": "Z00000000000000000000",
      "AllowedPattern": "^Z[A-Z0-9]+$",
      "Description": "Approved Route 53 hosted-zone ID supplied with the DNS approval."
    },
    "EnableDevelopmentEdge": {
      "Type": "String",
      "Default": "false",
      "AllowedValues": ["false", "true"],
      "Description": "Create the parameterized DNS/CloudFront resources only after the separate DNS and security decision is approved."
    },
    "AvailabilityZone": {
      "Type": "String",
      "Default": "ap-southeast-1a",
      "AllowedValues": ["ap-southeast-1a", "ap-southeast-1b", "ap-southeast-1c"],
      "Description": "Development host availability zone in the approved Singapore region."
    },
    "BundleId": {
      "Type": "String",
      "Default": "medium_3_0",
      "AllowedValues": ["medium_3_0"],
      "Description": "Approved starting Lightsail bundle: 4 GB class."
    },
    "BlueprintId": {
      "Type": "String",
      "Default": "ubuntu_24_04",
      "AllowedValues": ["ubuntu_24_04"],
      "Description": "Pinned host blueprint; host bootstrap is supplied through the separately approved host procedure."
    },
    "KeyPairName": {
      "Type": "String",
      "Default": "mmdc-v3-development-key",
      "AllowedPattern": "^[A-Za-z0-9._-]+$",
      "Description": "Existing development Lightsail key pair used only through the restricted operator path."
    },
    "SshCidr": {
      "Type": "String",
      "AllowedPattern": "^(?:[0-9]{1,3}\\.){3}[0-9]{1,3}/(?:[0-9]|[12][0-9]|3[0-2])$",
      "Description": "Approved single-operator IPv4 CIDR for restricted SSH access."
    }
  },
  "Rules": {
    "ApprovedRegion": {
      "Assertions": [
        {
          "Assert": {
            "Fn::Equals": [{ "Ref": "AWS::Region" }, "ap-southeast-1"]
          },
          "AssertDescription": "The MMDC development stack may be evaluated only in ap-southeast-1."
        }
      ]
    }
  },
  "Conditions": {
    "DevelopmentEdgeEnabled": {
      "Fn::Equals": [{ "Ref": "EnableDevelopmentEdge" }, "true"]
    }
  },
  "Resources": {
    "ApplicationRepository": {
      "Type": "AWS::ECR::Repository",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "RepositoryName": { "Fn::Sub": "${ProjectName}-${EnvironmentName}" },
        "ImageTagMutability": "IMMUTABLE",
        "ImageScanningConfiguration": { "ScanOnPush": true },
        "EncryptionConfiguration": { "EncryptionType": "AES256" },
        "LifecyclePolicy": {
          "LifecyclePolicyText": "{\"rules\":[{\"rulePriority\":1,\"description\":\"Retain the 30 most recent development images\",\"selection\":{\"tagStatus\":\"any\",\"countType\":\"imageCountMoreThan\",\"countNumber\":30},\"action\":{\"type\":\"expire\"}}]}"
        },
        "RepositoryPolicyText": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Sid": "DenyInsecureTransport",
              "Effect": "Deny",
              "Principal": "*",
              "Action": "ecr:*",
              "Condition": { "Bool": { "aws:SecureTransport": "false" } }
            }
          ]
        },
        "Tags": [
          { "Key": "Project", "Value": { "Ref": "ProjectName" } },
          { "Key": "Environment", "Value": { "Ref": "EnvironmentName" } },
          { "Key": "ManagedBy", "Value": "cloudformation" },
          { "Key": "Owner", "Value": { "Ref": "OwnerTag" } }
        ]
      }
    },
    "MediaBucket": {
      "Type": "AWS::S3::Bucket",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "BucketName": { "Fn::Sub": "${ProjectName}-${EnvironmentName}-media-${AWS::AccountId}-${AWS::Region}" },
        "BucketEncryption": {
          "ServerSideEncryptionConfiguration": [{ "ServerSideEncryptionByDefault": { "SSEAlgorithm": "AES256" } }]
        },
        "VersioningConfiguration": { "Status": "Enabled" },
        "OwnershipControls": { "Rules": [{ "ObjectOwnership": "BucketOwnerEnforced" }] },
        "PublicAccessBlockConfiguration": {
          "BlockPublicAcls": true,
          "BlockPublicPolicy": true,
          "IgnorePublicAcls": true,
          "RestrictPublicBuckets": true
        },
        "LifecycleConfiguration": {
          "Rules": [
            {
              "Id": "AbortIncompleteMultipartUploads",
              "Status": "Enabled",
              "AbortIncompleteMultipartUpload": { "DaysAfterInitiation": 7 }
            },
            {
              "Id": "RemoveOldNoncurrentVersions",
              "Status": "Enabled",
              "NoncurrentVersionExpiration": { "NoncurrentDays": 90, "NewerNoncurrentVersions": 5 }
            }
          ]
        },
        "Tags": [
          { "Key": "Project", "Value": { "Ref": "ProjectName" } },
          { "Key": "Environment", "Value": { "Ref": "EnvironmentName" } },
          { "Key": "ManagedBy", "Value": "cloudformation" },
          { "Key": "Owner", "Value": { "Ref": "OwnerTag" } }
        ]
      }
    },
    "MediaBucketPolicy": {
      "Type": "AWS::S3::BucketPolicy",
      "Properties": {
        "Bucket": { "Ref": "MediaBucket" },
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Sid": "DenyInsecureTransport",
              "Effect": "Deny",
              "Principal": "*",
              "Action": "s3:*",
              "Resource": [{ "Fn::GetAtt": ["MediaBucket", "Arn"] }, { "Fn::Sub": "${MediaBucket.Arn}/*" }],
              "Condition": { "Bool": { "aws:SecureTransport": "false" } }
            }
          ]
        }
      }
    },
    "BackupBucket": {
      "Type": "AWS::S3::Bucket",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "BucketName": { "Fn::Sub": "${ProjectName}-${EnvironmentName}-backups-${AWS::AccountId}-${AWS::Region}" },
        "BucketEncryption": {
          "ServerSideEncryptionConfiguration": [{ "ServerSideEncryptionByDefault": { "SSEAlgorithm": "AES256" } }]
        },
        "VersioningConfiguration": { "Status": "Enabled" },
        "OwnershipControls": { "Rules": [{ "ObjectOwnership": "BucketOwnerEnforced" }] },
        "PublicAccessBlockConfiguration": {
          "BlockPublicAcls": true,
          "BlockPublicPolicy": true,
          "IgnorePublicAcls": true,
          "RestrictPublicBuckets": true
        },
        "LifecycleConfiguration": {
          "Rules": [
            {
              "Id": "AbortIncompleteMultipartUploads",
              "Status": "Enabled",
              "AbortIncompleteMultipartUpload": { "DaysAfterInitiation": 7 }
            },
            {
              "Id": "ExpireDatabaseBackups",
              "Status": "Enabled",
              "ExpirationInDays": 35,
              "NoncurrentVersionExpiration": { "NoncurrentDays": 7, "NewerNoncurrentVersions": 2 }
            }
          ]
        },
        "Tags": [
          { "Key": "Project", "Value": { "Ref": "ProjectName" } },
          { "Key": "Environment", "Value": { "Ref": "EnvironmentName" } },
          { "Key": "ManagedBy", "Value": "cloudformation" },
          { "Key": "Owner", "Value": { "Ref": "OwnerTag" } }
        ]
      }
    },
    "BackupBucketPolicy": {
      "Type": "AWS::S3::BucketPolicy",
      "Properties": {
        "Bucket": { "Ref": "BackupBucket" },
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Sid": "DenyInsecureTransport",
              "Effect": "Deny",
              "Principal": "*",
              "Action": "s3:*",
              "Resource": [{ "Fn::GetAtt": ["BackupBucket", "Arn"] }, { "Fn::Sub": "${BackupBucket.Arn}/*" }],
              "Condition": { "Bool": { "aws:SecureTransport": "false" } }
            }
          ]
        }
      }
    },
    "DeploymentBucket": {
      "Type": "AWS::S3::Bucket",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "BucketName": { "Fn::Sub": "${ProjectName}-${EnvironmentName}-deployments-${AWS::AccountId}-${AWS::Region}" },
        "BucketEncryption": {
          "ServerSideEncryptionConfiguration": [{ "ServerSideEncryptionByDefault": { "SSEAlgorithm": "AES256" } }]
        },
        "VersioningConfiguration": { "Status": "Enabled" },
        "OwnershipControls": { "Rules": [{ "ObjectOwnership": "BucketOwnerEnforced" }] },
        "PublicAccessBlockConfiguration": {
          "BlockPublicAcls": true,
          "BlockPublicPolicy": true,
          "IgnorePublicAcls": true,
          "RestrictPublicBuckets": true
        },
        "LifecycleConfiguration": {
          "Rules": [
            {
              "Id": "AbortIncompleteDeploymentUploads",
              "Status": "Enabled",
              "AbortIncompleteMultipartUpload": { "DaysAfterInitiation": 7 }
            },
            {
              "Id": "ExpireOldDeploymentStatus",
              "Status": "Enabled",
              "ExpirationInDays": 30,
              "NoncurrentVersionExpiration": { "NoncurrentDays": 7, "NewerNoncurrentVersions": 5 }
            }
          ]
        },
        "Tags": [
          { "Key": "Project", "Value": { "Ref": "ProjectName" } },
          { "Key": "Environment", "Value": { "Ref": "EnvironmentName" } },
          { "Key": "ManagedBy", "Value": "cloudformation" },
          { "Key": "Owner", "Value": { "Ref": "OwnerTag" } }
        ]
      }
    },
    "DeploymentBucketPolicy": {
      "Type": "AWS::S3::BucketPolicy",
      "Properties": {
        "Bucket": { "Ref": "DeploymentBucket" },
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Sid": "DenyInsecureTransport",
              "Effect": "Deny",
              "Principal": "*",
              "Action": "s3:*",
              "Resource": [{ "Fn::GetAtt": ["DeploymentBucket", "Arn"] }, { "Fn::Sub": "${DeploymentBucket.Arn}/*" }],
              "Condition": { "Bool": { "aws:SecureTransport": "false" } }
            }
          ]
        }
      }
    },
    "GitHubDevelopmentDeployRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "RoleName": { "Fn::Sub": "${ProjectName}-${EnvironmentName}-github-deploy" },
        "MaxSessionDuration": 3600,
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Sid": "GitHubDevelopmentTagWorkflowOnly",
              "Effect": "Allow",
              "Principal": { "Federated": { "Ref": "GitHubOidcProviderArn" } },
              "Action": "sts:AssumeRoleWithWebIdentity",
              "Condition": {
                "StringEquals": { "token.actions.githubusercontent.com:aud": "sts.amazonaws.com" },
                "StringLike": {
                  "token.actions.githubusercontent.com:sub": [
                    { "Fn::Sub": "repo:${GitHubRepository}:*" },
                    { "Fn::Sub": "${GitHubImmutableSubjectPrefix}:*" }
                  ],
                  "token.actions.githubusercontent.com:job_workflow_ref": { "Ref": "GitHubWorkflowRef" }
                }
              }
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "PublishDevelopmentImageAndDesiredState",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Sid": "EcrTokenForAwsRegistry",
                  "Effect": "Allow",
                  "Action": "ecr:GetAuthorizationToken",
                  "Resource": "*"
                },
                {
                  "Sid": "PublishOnlyDevelopmentRepository",
                  "Effect": "Allow",
                  "Action": [
                    "ecr:BatchCheckLayerAvailability",
                    "ecr:CompleteLayerUpload",
                    "ecr:DescribeImages",
                    "ecr:DescribeRepositories",
                    "ecr:InitiateLayerUpload",
                    "ecr:PutImage",
                    "ecr:UploadLayerPart"
                  ],
                  "Resource": { "Fn::GetAtt": ["ApplicationRepository", "Arn"] }
                },
                {
                  "Sid": "WriteOnlyDevelopmentDesiredState",
                  "Effect": "Allow",
                  "Action": "s3:PutObject",
                  "Resource": { "Fn::Sub": "${DeploymentBucket.Arn}/desired.json" }
                }
              ]
            }
          }
        ],
        "Tags": [
          { "Key": "Project", "Value": { "Ref": "ProjectName" } },
          { "Key": "Environment", "Value": { "Ref": "EnvironmentName" } },
          { "Key": "ManagedBy", "Value": "cloudformation" },
          { "Key": "Owner", "Value": { "Ref": "OwnerTag" } }
        ]
      }
    },
    "ApplicationStorageUser": {
      "Type": "AWS::IAM::User",
      "Properties": {
        "UserName": { "Fn::Sub": "${ProjectName}-${EnvironmentName}-storage" },
        "Policies": [
          {
            "PolicyName": "PullDevelopmentImageStateAndMedia",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Sid": "EcrTokenForAwsRegistry",
                  "Effect": "Allow",
                  "Action": "ecr:GetAuthorizationToken",
                  "Resource": "*"
                },
                {
                  "Sid": "PullOnlyDevelopmentRepository",
                  "Effect": "Allow",
                  "Action": ["ecr:BatchCheckLayerAvailability", "ecr:BatchGetImage", "ecr:GetDownloadUrlForLayer"],
                  "Resource": { "Fn::GetAtt": ["ApplicationRepository", "Arn"] }
                },
                {
                  "Sid": "ReadDesiredStateOnly",
                  "Effect": "Allow",
                  "Action": "s3:GetObject",
                  "Resource": { "Fn::Sub": "${DeploymentBucket.Arn}/desired.json" }
                },
                {
                  "Sid": "WriteBoundedDeploymentStatus",
                  "Effect": "Allow",
                  "Action": "s3:PutObject",
                  "Resource": { "Fn::Sub": "${DeploymentBucket.Arn}/status/*" }
                },
                {
                  "Sid": "GetDevelopmentMediaBucketLocation",
                  "Effect": "Allow",
                  "Action": "s3:GetBucketLocation",
                  "Resource": { "Fn::GetAtt": ["MediaBucket", "Arn"] }
                },
                {
                  "Sid": "ListDevelopmentMediaPrefixOnly",
                  "Effect": "Allow",
                  "Action": "s3:ListBucket",
                  "Resource": { "Fn::GetAtt": ["MediaBucket", "Arn"] },
                  "Condition": { "StringLike": { "s3:prefix": ["media", "media/*"] } }
                },
                {
                  "Sid": "OperateOnDevelopmentMediaObjectsOnly",
                  "Effect": "Allow",
                  "Action": [
                    "s3:AbortMultipartUpload",
                    "s3:DeleteObject",
                    "s3:GetObject",
                    "s3:ListMultipartUploadParts",
                    "s3:PutObject"
                  ],
                  "Resource": { "Fn::Sub": "${MediaBucket.Arn}/media/*" }
                },
                {
                  "Sid": "ListDevelopmentBackups",
                  "Effect": "Allow",
                  "Action": ["s3:GetBucketLocation", "s3:ListBucket"],
                  "Resource": { "Fn::GetAtt": ["BackupBucket", "Arn"] }
                },
                {
                  "Sid": "ManageDevelopmentBackupObjects",
                  "Effect": "Allow",
                  "Action": ["s3:AbortMultipartUpload", "s3:GetObject", "s3:ListMultipartUploadParts", "s3:PutObject"],
                  "Resource": { "Fn::Sub": "${BackupBucket.Arn}/*" }
                }
              ]
            }
          }
        ],
        "Tags": [
          { "Key": "Project", "Value": { "Ref": "ProjectName" } },
          { "Key": "Environment", "Value": { "Ref": "EnvironmentName" } },
          { "Key": "ManagedBy", "Value": "cloudformation" },
          { "Key": "Owner", "Value": { "Ref": "OwnerTag" } }
        ]
      }
    },
    "DevelopmentInstance": {
      "Type": "AWS::Lightsail::Instance",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "InstanceName": { "Fn::Sub": "${ProjectName}-${EnvironmentName}-app" },
        "AvailabilityZone": { "Ref": "AvailabilityZone" },
        "BlueprintId": { "Ref": "BlueprintId" },
        "BundleId": { "Ref": "BundleId" },
        "KeyPairName": { "Ref": "KeyPairName" },
        "AddOns": [
          {
            "AddOnType": "AutoSnapshot",
            "AutoSnapshotAddOnRequest": { "SnapshotTimeOfDay": "18:00" },
            "Status": "Enabled"
          }
        ],
        "Networking": {
          "Ports": [
            {
              "AccessDirection": "inbound",
              "AccessFrom": "Custom",
              "AccessType": "Public",
              "CidrListAliases": ["lightsail-connect"],
              "Cidrs": [{ "Ref": "SshCidr" }],
              "CommonName": "SSH",
              "FromPort": 22,
              "Protocol": "tcp",
              "ToPort": 22
            },
            {
              "AccessDirection": "inbound",
              "AccessFrom": "Anywhere (0.0.0.0/0)",
              "AccessType": "Public",
              "Cidrs": ["0.0.0.0/0"],
              "CommonName": "HTTP",
              "FromPort": 80,
              "Protocol": "tcp",
              "ToPort": 80
            },
            {
              "AccessDirection": "inbound",
              "AccessFrom": "Anywhere (0.0.0.0/0)",
              "AccessType": "Public",
              "Cidrs": ["0.0.0.0/0"],
              "CommonName": "HTTPS",
              "FromPort": 443,
              "Protocol": "tcp",
              "ToPort": 443
            }
          ]
        },
        "UserData": "#!/usr/bin/env bash\nset -euo pipefail\nexport DEBIAN_FRONTEND=noninteractive\n\napt-get update\napt-get install -y --no-install-recommends \\\n  ca-certificates \\\n  curl \\\n  docker-compose-v2 \\\n  docker.io \\\n  fail2ban \\\n  jq \\\n  openssl \\\n  unattended-upgrades\n\nsystemctl enable --now docker\nsystemctl enable --now fail2ban\nsystemctl enable --now unattended-upgrades\nusermod -aG docker ubuntu\n\ninstall -d -m 0750 -o root -g docker /opt/mmdc\ninstall -d -m 0750 -o root -g docker /opt/mmdc/backups\ninstall -d -m 0750 -o root -g docker /opt/mmdc/bin\ninstall -d -m 0750 -o root -g docker /opt/mmdc/imports\ninstall -d -m 0750 -o root -g docker /opt/mmdc/secrets\ntouch /var/lib/cloud/instance/mmdc-base-ready\n",
        "Tags": [
          { "Key": "Project", "Value": { "Ref": "ProjectName" } },
          { "Key": "Environment", "Value": { "Ref": "EnvironmentName" } },
          { "Key": "ManagedBy", "Value": "cloudformation" },
          { "Key": "Owner", "Value": { "Ref": "OwnerTag" } }
        ]
      }
    },
    "DevelopmentInstanceAdditional": {
      "Type": "AWS::Lightsail::Instance",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "InstanceName": { "Fn::Sub": "${ProjectName}-${EnvironmentName}-app-02" },
        "AvailabilityZone": { "Ref": "AvailabilityZone" },
        "BlueprintId": { "Ref": "BlueprintId" },
        "BundleId": { "Ref": "BundleId" },
        "KeyPairName": { "Ref": "KeyPairName" },
        "AddOns": [
          {
            "AddOnType": "AutoSnapshot",
            "AutoSnapshotAddOnRequest": { "SnapshotTimeOfDay": "18:00" },
            "Status": "Enabled"
          }
        ],
        "Networking": {
          "Ports": [
            {
              "AccessDirection": "inbound",
              "AccessFrom": "Custom",
              "AccessType": "Public",
              "CidrListAliases": ["lightsail-connect"],
              "Cidrs": [{ "Ref": "SshCidr" }],
              "CommonName": "SSH",
              "FromPort": 22,
              "Protocol": "tcp",
              "ToPort": 22
            },
            {
              "AccessDirection": "inbound",
              "AccessFrom": "Anywhere (0.0.0.0/0)",
              "AccessType": "Public",
              "Cidrs": ["0.0.0.0/0"],
              "CommonName": "HTTP",
              "FromPort": 80,
              "Protocol": "tcp",
              "ToPort": 80
            },
            {
              "AccessDirection": "inbound",
              "AccessFrom": "Anywhere (0.0.0.0/0)",
              "AccessType": "Public",
              "Cidrs": ["0.0.0.0/0"],
              "CommonName": "HTTPS",
              "FromPort": 443,
              "Protocol": "tcp",
              "ToPort": 443
            }
          ]
        },
        "UserData": "#!/usr/bin/env bash\nset -euo pipefail\nexport DEBIAN_FRONTEND=noninteractive\n\napt-get update\napt-get install -y --no-install-recommends \\\n  ca-certificates \\\n  curl \\\n  docker-compose-v2 \\\n  docker.io \\\n  fail2ban \\\n  jq \\\n  openssl \\\n  unattended-upgrades\n\nsystemctl enable --now docker\nsystemctl enable --now fail2ban\nsystemctl enable --now unattended-upgrades\nusermod -aG docker ubuntu\n\ninstall -d -m 0750 -o root -g docker /opt/mmdc\ninstall -d -m 0750 -o root -g docker /opt/mmdc/backups\ninstall -d -m 0750 -o root -g docker /opt/mmdc/bin\ninstall -d -m 0750 -o root -g docker /opt/mmdc/imports\ninstall -d -m 0750 -o root -g docker /opt/mmdc/secrets\ntouch /var/lib/cloud/instance/mmdc-base-ready\n",
        "Tags": [
          { "Key": "Project", "Value": { "Ref": "ProjectName" } },
          { "Key": "Environment", "Value": { "Ref": "EnvironmentName" } },
          { "Key": "ManagedBy", "Value": "cloudformation" },
          { "Key": "Owner", "Value": { "Ref": "OwnerTag" } }
        ]
      }
    },
    "DevelopmentStaticIp": {
      "Type": "AWS::Lightsail::StaticIp",
      "Properties": {
        "StaticIpName": { "Fn::Sub": "${ProjectName}-${EnvironmentName}-ip" },
        "AttachedTo": { "Ref": "DevelopmentInstance" }
      }
    },
    "DevelopmentStaticIpAdditional": {
      "Type": "AWS::Lightsail::StaticIp",
      "Properties": {
        "StaticIpName": { "Fn::Sub": "${ProjectName}-${EnvironmentName}-ip-02" },
        "AttachedTo": { "Ref": "DevelopmentInstanceAdditional" }
      }
    },
    "DevelopmentCpuAlarm": {
      "Type": "AWS::CloudWatch::Alarm",
      "Properties": {
        "AlarmName": { "Fn::Sub": "${ProjectName}-${EnvironmentName}-lightsail-cpu-high" },
        "AlarmDescription": "Development host CPU is high; notification wiring requires the approved observability decision.",
        "Namespace": "AWS/Lightsail",
        "MetricName": "CPUUtilization",
        "Dimensions": [{ "Name": "InstanceName", "Value": { "Ref": "DevelopmentInstance" } }],
        "Statistic": "Average",
        "Period": 300,
        "EvaluationPeriods": 2,
        "Threshold": 80,
        "ComparisonOperator": "GreaterThanThreshold",
        "TreatMissingData": "notBreaching",
        "Tags": [
          { "Key": "Project", "Value": { "Ref": "ProjectName" } },
          { "Key": "Environment", "Value": { "Ref": "EnvironmentName" } },
          { "Key": "ManagedBy", "Value": "cloudformation" },
          { "Key": "Owner", "Value": { "Ref": "OwnerTag" } }
        ]
      }
    },
    "DevelopmentBurstCapacityAlarm": {
      "Type": "AWS::CloudWatch::Alarm",
      "Properties": {
        "AlarmName": { "Fn::Sub": "${ProjectName}-${EnvironmentName}-lightsail-burst-low" },
        "AlarmDescription": "Development host burst capacity is low; notification wiring requires the approved observability decision.",
        "Namespace": "AWS/Lightsail",
        "MetricName": "BurstCapacityPercentage",
        "Dimensions": [{ "Name": "InstanceName", "Value": { "Ref": "DevelopmentInstance" } }],
        "Statistic": "Average",
        "Period": 300,
        "EvaluationPeriods": 2,
        "Threshold": 20,
        "ComparisonOperator": "LessThanThreshold",
        "TreatMissingData": "notBreaching",
        "Tags": [
          { "Key": "Project", "Value": { "Ref": "ProjectName" } },
          { "Key": "Environment", "Value": { "Ref": "EnvironmentName" } },
          { "Key": "ManagedBy", "Value": "cloudformation" },
          { "Key": "Owner", "Value": { "Ref": "OwnerTag" } }
        ]
      }
    },
    "DevelopmentCloudFrontDistribution": {
      "Condition": "DevelopmentEdgeEnabled",
      "Type": "AWS::CloudFront::Distribution",
      "Properties": {
        "DistributionConfig": {
          "Enabled": true,
          "Comment": "MMDC development edge; private-origin verification and Basic Auth are supplied through the approved edge procedure.",
          "HttpVersion": "http2",
          "PriceClass": "PriceClass_100",
          "Origins": [
            {
              "Id": "DevelopmentLightsailOrigin",
              "DomainName": { "Ref": "DevelopmentOriginHostname" },
              "CustomOriginConfig": {
                "HTTPPort": 80,
                "HTTPSPort": 443,
                "OriginProtocolPolicy": "http-only"
              }
            }
          ],
          "DefaultCacheBehavior": {
            "TargetOriginId": "DevelopmentLightsailOrigin",
            "ViewerProtocolPolicy": "redirect-to-https",
            "AllowedMethods": ["GET", "HEAD", "OPTIONS", "PUT", "POST", "PATCH", "DELETE"],
            "CachedMethods": ["GET", "HEAD", "OPTIONS"],
            "ForwardedValues": { "QueryString": true, "Cookies": { "Forward": "all" } },
            "Compress": true
          },
          "ViewerCertificate": { "CloudFrontDefaultCertificate": true }
        },
        "Tags": [
          { "Key": "Project", "Value": { "Ref": "ProjectName" } },
          { "Key": "Environment", "Value": { "Ref": "EnvironmentName" } },
          { "Key": "ManagedBy", "Value": "cloudformation" },
          { "Key": "Owner", "Value": { "Ref": "OwnerTag" } }
        ]
      }
    },
    "DevelopmentDnsRecord": {
      "Condition": "DevelopmentEdgeEnabled",
      "Type": "AWS::Route53::RecordSet",
      "Properties": {
        "HostedZoneId": { "Ref": "HostedZoneId" },
        "Name": { "Ref": "DevelopmentHostname" },
        "Type": "A",
        "AliasTarget": {
          "DNSName": { "Fn::GetAtt": ["DevelopmentCloudFrontDistribution", "DomainName"] },
          "HostedZoneId": "Z2FDTNDATAQYW2"
        }
      }
    }
  },
  "Outputs": {
    "InstanceName": {
      "Description": "Existing development Lightsail instance name.",
      "Value": { "Ref": "DevelopmentInstance" }
    },
    "InstancePublicIp": {
      "Description": "Existing development Lightsail static public IP.",
      "Value": { "Fn::GetAtt": ["DevelopmentStaticIp", "IpAddress"] }
    },
    "AdditionalInstanceName": {
      "Description": "New additive development Lightsail instance name.",
      "Value": { "Ref": "DevelopmentInstanceAdditional" }
    },
    "AdditionalInstancePublicIp": {
      "Description": "New additive development Lightsail static public IP.",
      "Value": { "Fn::GetAtt": ["DevelopmentStaticIpAdditional", "IpAddress"] }
    },
    "ApplicationRepositoryUri": {
      "Description": "Private development ECR repository URI.",
      "Value": { "Fn::GetAtt": ["ApplicationRepository", "RepositoryUri"] }
    },
    "MediaBucketName": {
      "Description": "Private development media bucket name.",
      "Value": { "Ref": "MediaBucket" }
    },
    "BackupBucketName": {
      "Description": "Private development backup bucket name.",
      "Value": { "Ref": "BackupBucket" }
    },
    "DeploymentBucketName": {
      "Description": "Private development deployment-state bucket name.",
      "Value": { "Ref": "DeploymentBucket" }
    },
    "GitHubDevelopmentDeployRoleArn": {
      "Description": "Constrained GitHub OIDC publisher role ARN.",
      "Value": { "Fn::GetAtt": ["GitHubDevelopmentDeployRole", "Arn"] }
    },
    "ApplicationStorageUserName": {
      "Description": "Scoped host workload IAM user name; access keys are created only by the approved bootstrap procedure.",
      "Value": { "Ref": "ApplicationStorageUser" }
    },
    "SshCommand": {
      "Description": "Restricted operator connection command.",
      "Value": { "Fn::Sub": "ssh ubuntu@${DevelopmentStaticIp.IpAddress}" }
    },
    "MonthlyPlanningCostEstimate": {
      "Description": "Planning estimate only; not a provider quote or approval to provision.",
      "Value": "USD 80-205 per month for the concurrent two-host AWS development bundle; registered planning envelope USD 40-265; two-host sensitivity envelope USD 80-345."
    },
    "ApprovedRegion": {
      "Description": "Region guard applied by the template.",
      "Value": { "Ref": "AWS::Region" }
    }
  }
}
