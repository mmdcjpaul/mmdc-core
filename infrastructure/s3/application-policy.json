{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "MediaObjectOperationsOnly",
      "Effect": "Allow",
      "Action": [
        "s3:AbortMultipartUpload",
        "s3:DeleteObject",
        "s3:GetObject",
        "s3:ListMultipartUploadParts",
        "s3:PutObject"
      ],
      "Resource": "arn:aws:s3:::${MMDC_MEDIA_BUCKET}/media/*"
    }
  ]
}
