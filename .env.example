# Required at runtime; never expose this as NEXT_PUBLIC_PAYLOAD_SECRET.
PAYLOAD_SECRET=replace-with-a-long-random-runtime-secret

# Required at runtime by the Payload Postgres adapter.
DATABASE_URL=postgresql://mmdc@127.0.0.1:5432/mmdc_local

# Required for migrations, inspection, logical backups, and restore validation.
# Shared Neon environments must use a distinct TLS-required direct endpoint.
DATABASE_DIRECT_URL=postgresql://mmdc@127.0.0.1:5432/mmdc_local

# local | ci | development | staging | production; protected environments
# refuse seed/reset unless the documented break-glass record is supplied.
MMDC_ENVIRONMENT=local

# postgres uses the loopback-only PostgreSQL 17 Compose compatibility service.
# neon requires an explicitly named isolated branch beginning with local-.
MMDC_DATABASE_MODE=postgres
MMDC_DATABASE_TARGET_NAME=local-postgres-compatibility
MMDC_DATABASE_TARGET_CONFIRMATION=
MMDC_NEON_BRANCH=

# Bounded pooled runtime settings; DATABASE_URL remains the pooled application URL.
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_IDLE_TIMEOUT_MS=30000

# Optional server-only endpoint for internal services.
INTERNAL_API_URL=

# Test-only local compatibility database; never set this in shared environments.
MMDC_COMPATIBILITY_DATABASE=

# Local filesystem media is the default and does not require AWS credentials.
MMDC_MEDIA_STORAGE=local
MMDC_MEDIA_DIR=

# Local service ports remain loopback-only unless the documented confirmation is supplied.
MMDC_LOCAL_SERVICE_BIND_ADDRESS=127.0.0.1
MMDC_NON_LOOPBACK_CONFIRMATION=

# Break-glass values are supplied only by an approved operator and are never
# committed. See docs/runbooks/neon-operations.md.
MMDC_BREAK_GLASS=
MMDC_BREAK_GLASS_APPROVAL_FILE=

# The only browser-visible environment value in this foundation.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
