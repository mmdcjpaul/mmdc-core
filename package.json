{
  "name": "mmdc-core",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": "24.15.0",
    "pnpm": "11.20.0"
  },
  "scripts": {
    "preinstall": "node scripts/check-runtime.mjs --package-manager",
    "check:runtime": "node scripts/check-runtime.mjs --package-manager",
    "check:policy": "node scripts/check-scaffold-policy.mjs",
    "dev": "next dev",
