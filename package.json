{
  "name": "mmdc-core",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": "24.15.0",
    "pnpm": "11.20.0"
  },
  "scripts": {
    "preinstall": "node scripts/check-runtime.mjs --package-manager",
    "check:runtime": "node scripts/check-runtime.mjs --package-manager",
    "check:policy": "node scripts/check-scaffold-policy.mjs",
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build --webpack",
    "start": "next start",
    "format": "prettier --write README.md package.json next.config.mjs tsconfig.json payload.config.ts scripts/payload-command.mjs scripts/payload-migrate.mjs scripts/payload-bootstrap.mjs scripts/payload-seed.mjs scripts/neon-recovery.mjs scripts/local-services.mjs src/environment.ts src/collections src/migrations src/operations tests/unit tests/integration",
    "format:check": "prettier --check README.md package.json next.config.mjs tsconfig.json payload.config.ts scripts/payload-command.mjs scripts/payload-migrate.mjs scripts/payload-bootstrap.mjs scripts/payload-seed.mjs scripts/neon-recovery.mjs scripts/local-services.mjs src/environment.ts src/collections src/migrations src/operations tests/unit tests/integration",
    "check:dependencies": "node scripts/check-dependency-triage.mjs",
    "lint": "eslint .",
    "generate:types": "node scripts/payload-command.mjs generate:types",
    "migrate": "node --import tsx scripts/payload-migrate.mjs migrate",
    "migrate:create": "node --import tsx scripts/payload-migrate.mjs migrate:create",
    "migrate:status": "node --import tsx scripts/payload-migrate.mjs migrate:status",
    "bootstrap": "node --import tsx scripts/payload-bootstrap.mjs",
    "seed": "node --import tsx scripts/payload-seed.mjs",
    "reset": "node --import tsx scripts/payload-seed.mjs --reset",
    "test:neon": "node --import tsx tests/integration/neon-compatibility.test.ts --contract-only",
    "test": "node --import tsx --test tests/unit/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.88.0",
    "@payloadcms/db-sqlite": "3.88.0",
    "@payloadcms/next": "3.88.0",
    "next": "16.3.1",
    "payload": "3.88.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "0.34.5"
  },
  "devDependencies": {
    "@types/node": "24.0.3",
    "@types/react": "19.1.2",
    "@types/react-dom": "19.1.2",
    "autoprefixer": "10.4.21",
    "eslint": "9.23.0",
    "eslint-config-next": "16.3.1",
    "postcss": "8.5.3",
    "prettier": "3.5.3",
    "tailwindcss": "3.4.17",
    "tsx": "4.22.4",
    "typescript": "5.8.3"
  }
}
